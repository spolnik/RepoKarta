---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Props {
	image: ImageMetadata;
	alt: string;
	caption: string;
	meta: string;
}

const { image, alt, caption, meta } = Astro.props;
---

<figure class="visual-frame">
	<Image
		src={image}
		alt={alt}
		widths={[720, 1080, 1440]}
		sizes="(max-width: 50rem) 100vw, 1080px"
		loading="lazy"
	/>
	<figcaption>
		<span>{caption}</span>
		<span>{meta}</span>
	</figcaption>
</figure>
