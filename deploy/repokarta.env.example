# Non-secret shared-deployment settings. Keep credentials in separate
# permission-restricted files.
REPOKARTA_AUTH_MODE=saml
REPOKARTA_PUBLIC_URL=https://repokarta.example.com
REPOKARTA_SAML_METADATA_URL=https://idp.example.com/metadata
REPOKARTA_SAML_ENTITY_ID=https://repokarta.example.com/saml/metadata
REPOKARTA_ADMIN_USER=repokarta-admin
REPOKARTA_ADMIN_PASSWORD_FILE=/etc/repokarta/admin-password
REPOKARTA_SCIM_TOKEN_FILE=/etc/repokarta/scim-token

# Optional PostgreSQL 18+ metadata backend. Omit this setting to keep SQLite.
# The file contains one standard PostgreSQL URL and must be mode 0600.
# Example:
# postgresql://repokarta:password@db.example.com:5432/repokarta?sslmode=verify-full
# REPOKARTA_DATABASE_URL_FILE=/etc/repokarta/postgres-url

# For Cloudflare Access, use these settings instead of the SAML settings:
# REPOKARTA_AUTH_MODE=cloudflare-access
# REPOKARTA_CF_TEAM_DOMAIN=https://team.cloudflareaccess.com
# REPOKARTA_CF_AUDIENCE=replace-with-access-application-audience
